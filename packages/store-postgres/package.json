{
  "name": "@pactmark/store-postgres",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokomotifai/pactmark.git",
    "directory": "packages/store-postgres"
  },
  "description": "Tenant-scoped durable PostgreSQL stores for Pactmark",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:postgres-tls": "vitest run --config vitest.tls.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@pactmark/core": "workspace:*",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "@pactmark/testing": "workspace:*",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
