{
  "name": "@pactmark/ai-sdk",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokomotifai/pactmark.git",
    "directory": "packages/ai-sdk"
  },
  "description": "Vercel AI SDK model adapter for Pactmark",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@pactmark/core": "workspace:*"
  },
  "peerDependencies": {
    "ai": "^7.0.48"
  },
  "devDependencies": {
    "@pactmark/agent": "workspace:*",
    "@types/node": "22.20.1",
    "ai": "7.0.48",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
