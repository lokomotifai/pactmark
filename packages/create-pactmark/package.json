{
  "name": "create-pactmark",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokomotifai/pactmark.git",
    "directory": "packages/create-pactmark"
  },
  "description": "Deterministic, offline Pactmark project initializer",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "create-pactmark": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsdown && vitest run",
    "test:coverage": "tsdown && vitest run --coverage"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
