{
  "name": "pactmark-example-quickstart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node --import tsx src/run.ts",
    "smoke:live": "node --import tsx src/live-provider-smoke.ts",
    "lint": "eslint . --config ../eslint.config.mjs --max-warnings 0",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pactmark/agent": "workspace:*",
    "@pactmark/ai-sdk": "workspace:*",
    "ai": "7.0.48",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "tsdown": "0.23.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.10"
  }
}
