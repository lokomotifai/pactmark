{
  "schemaVersion": "1",
  "aggregates": {
    "verify:release": [
      "format:check",
      "lint",
      "typecheck",
      "build",
      "test:unit",
      "test:integration",
      "test:consumer",
      "test:portability",
      "test:examples",
      "test:example-readmes",
      "test:store-contracts",
      "migration:check",
      "test:durable-resume",
      "test:postgres-tls",
      "test:container-tooling",
      "test:container",
      "test:vercel-contract",
      "test:ui-security",
      "test:ui-accessibility",
      "test:cloudflare-dry-run",
      "test:performance",
      "benchmark:local",
      "api:check",
      "registration:check",
      "naming:check",
      "boundaries:check",
      "placeholders:check",
      "security:verify",
      "docs:check",
      "pack:check",
      "release:dry-run"
    ],
    "security:verify": [
      "test:security",
      "test:properties",
      "test:authorization-reservations",
      "test:commands-crash-matrix",
      "test:registration-digests",
      "test:credential-boundaries",
      "test:admission",
      "test:sandbox-contract",
      "test:sandbox-container",
      "policy:wiring-check",
      "audit:dependencies:offline",
      "audit:licenses",
      "audit:workflows",
      "audit:secrets",
      "audit:release-commands",
      "sbom:generate",
      "public-surface:check"
    ]
  },
  "externalGates": ["audit:dependencies:live", "docs:external-links:live", "release:platform:live"],
  "forbiddenNoOpPatterns": [
    "^true$",
    "^echo(?:\\s|$)",
    "exit\\s+0",
    "\\|\\|\\s*true",
    "KAF_SKIP",
    "SKIP_.*(?:=|\\])"
  ]
}
