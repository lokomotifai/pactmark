{
  "name": "pactmark-workspace",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokomotifai/pactmark.git"
  },
  "private": true,
  "description": "Evidence-native TypeScript agent framework workspace",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.14.0 || ^24.0.0",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.tooling.json --noEmit && turbo run typecheck",
    "build": "tsc -p tsconfig.tooling.json && turbo run build",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:consumer && pnpm test:portability && pnpm test:security",
    "test:unit": "vitest run --config vitest.config.ts && turbo run test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:consumer": "vitest run --config vitest.consumer.config.ts",
    "test:portability": "turbo run test --filter=@pactmark/http --filter=@pactmark/node --filter=@pactmark/vercel --filter=@pactmark/cloudflare --filter=pactmark-node-quickstart --filter=pactmark-example-portable-agent --filter=nextjs-vercel --filter=cloudflare-worker",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:properties": "vitest run --root packages/policy tests/canonicalization.test.ts",
    "test:authorization-reservations": "vitest run --root packages/core tests/runtime-contracts.test.ts",
    "test:commands-crash-matrix": "vitest run --root packages/runtime tests/runtime.test.ts",
    "test:runtime-crash-matrix": "vitest run --root packages/runtime tests/runtime.test.ts -t 'recovers R0-R1 execution from a fresh runtime after committed'",
    "test:runtime-concurrency": "vitest run --root packages/runtime tests/runtime.test.ts -t 'lease for exclusivity|concurrent|atomically enqueues durable'",
    "test:streaming": "vitest run --root packages/runtime tests/runtime.test.ts -t 'tails events after a sequence|event polling|AbortSignals'",
    "test:effects-crash-matrix": "vitest run --root packages/runtime tests/runtime.test.ts -t 'effect|reconciliation|compensation'",
    "test:credential-boundaries": "vitest run --root packages/core tests/identity-model.test.ts tests/edge-coverage.test.ts",
    "test:admission": "vitest run --root packages/core tests/authority-work-order.test.ts",
    "test:sandbox-contract": "vitest run --root packages/mcp tests/stdio.test.ts",
    "bootstrap:sandbox-container-base": "node --import tsx tooling/sandbox-container/bootstrap-base-image.mts",
    "test:sandbox-container": "node --import tsx tooling/sandbox-container/run-conformance.mts",
    "bootstrap:executor-sh-image": "node --import tsx tooling/executor-sh/bootstrap-image.mts",
    "test:executor-sh-container": "node --import tsx tooling/executor-sh/run-conformance.mts",
    "test:executor-sh-packed": "node --import tsx tooling/executor-sh/run-packed-consumer.mts",
    "test:executor-sh-read-tools:live": "node --import tsx tooling/executor-sh/run-live-read-tools.mts",
    "test:examples": "turbo run test --filter=pactmark-example-* --filter=pactmark-node-quickstart",
    "test:example-readmes": "node --import tsx tooling/check-example-readmes.mts",
    "test:loopback-registry": "vitest run --config vitest.integration.config.ts tests/integration/loopback-registry.test.ts",
    "test:store-contracts": "pnpm --filter @pactmark/testing test && pnpm --filter @pactmark/store-postgres test",
    "migration:check": "pnpm --filter @pactmark/store-postgres exec vitest run tests/database-migrations-leases.test.ts tests/store-postgres.test.ts",
    "test:scaffolds": "pnpm --filter create-pactmark test",
    "test:quickstart": "vitest run --root apps/node-quickstart",
    "test:mcp": "pnpm --filter @pactmark/mcp test",
    "test:http": "pnpm --filter @pactmark/http test",
    "test:telemetry": "pnpm --filter @pactmark/otel test",
    "test:postgres-worker": "pnpm --filter @pactmark/driver-postgres-worker test && node --import tsx tooling/test-postgres-service.mts",
    "test:postgres-tls": "pnpm --filter @pactmark/store-postgres test:postgres-tls",
    "test:public-facade-consumer": "vitest run --config vitest.consumer.config.ts",
    "test:public-snippet": "pnpm --filter @pactmark/agent test",
    "test:adapters": "turbo run test --filter=@pactmark/ai-sdk --filter=@pactmark/mcp --filter=@pactmark/executor-sh --filter=@pactmark/http --filter=@pactmark/node --filter=@pactmark/vercel --filter=@pactmark/cloudflare --filter=@pactmark/otel",
    "test:vercel-contract": "turbo run test --filter=@pactmark/vercel --filter=@pactmark/http --filter=pactmark-node-quickstart --filter=nextjs-vercel",
    "test:ui-security": "pnpm --filter nextjs-vercel exec vitest run tests/security.test.ts",
    "test:ui-accessibility": "pnpm --filter nextjs-vercel exec vitest run tests/accessibility.test.ts",
    "test:cloudflare-dry-run": "pnpm --filter cloudflare-worker types:check && pnpm --filter cloudflare-worker deploy:dry-run",
    "test:performance": "vitest run --config tests/performance/vitest.config.ts",
    "benchmark:local": "node --import tsx tooling/benchmarks/run-local.mts",
    "test:evidence-integrity": "pnpm --filter @pactmark/evidence test",
    "test:pattern-maturity": "pnpm --filter @pactmark/evidence test",
    "test:redaction": "pnpm --filter @pactmark/evidence test",
    "test:terminal-safety": "pnpm --filter @pactmark/cli test",
    "test:secret-canaries": "pnpm audit:secrets && pnpm --filter @pactmark/policy exec vitest run tests/secrets.test.ts && pnpm --filter @pactmark/runtime exec vitest run tests/runtime.test.ts -t 'secret|credential'",
    "test:documented-quickstart": "pnpm test:loopback-registry",
    "test:durable-resume": "node --import tsx tooling/test-postgres-service.mts",
    "test:container": "node --import tsx tooling/container/run-conformance.mts",
    "test:container-tooling": "vitest run --config tests/tooling/vitest.config.ts",
    "security:verify": "pnpm test:security && pnpm test:properties && pnpm test:authorization-reservations && pnpm test:commands-crash-matrix && pnpm test:registration-digests && pnpm test:credential-boundaries && pnpm test:admission && pnpm test:sandbox-contract && pnpm test:sandbox-container && pnpm test:executor-sh-container && pnpm audit:dependencies:offline && pnpm audit:licenses && pnpm audit:workflows && pnpm audit:secrets && pnpm audit:release-commands && pnpm sbom:generate && pnpm public-surface:check",
    "docs:prepare": "pnpm --filter pactmark-docs prepare",
    "docs:build": "pnpm --filter pactmark-docs build",
    "docs:snippets": "pnpm docs:prepare",
    "docs:translations": "pnpm --filter pactmark-docs test",
    "docs:a11y": "node --import tsx tooling/docs/check-built-site.mts",
    "docs:check": "node --import tsx tooling/check-docs.mts && pnpm docs:snippets && pnpm docs:translations && pnpm docs:a11y",
    "pack:check": "node --import tsx tooling/check-public-surface.mts",
    "public-surface:check": "node --import tsx tooling/check-public-surface.mts",
    "placeholders:check": "node --import tsx tooling/check-placeholders.mts",
    "boundaries:check": "dependency-cruiser . --config .dependency-cruiser.cjs && pnpm portable:check",
    "portable:check": "node --import tsx tooling/check-portable-imports.mts",
    "registration:check": "node --import tsx tooling/check-registration-version.mts",
    "naming:check": "node --import tsx tooling/check-naming-freeze.mts",
    "test:registration-digests": "pnpm --filter @pactmark/core test -- --run identity-model.test.ts",
    "api:report": "pnpm --filter @pactmark/core api:report && pnpm --filter @pactmark/agent api:report && pnpm --filter @pactmark/testing api:report",
    "api:check": "pnpm --filter @pactmark/core api:check && pnpm --filter @pactmark/agent api:check && pnpm --filter @pactmark/testing api:check",
    "verify:manifest": "node --import tsx tooling/verify-gate-manifest.mts",
    "verify:portable-host": "pnpm typecheck && pnpm build && pnpm test:unit && pnpm test:consumer && pnpm test:portability",
    "verify:clean-source": "node --import tsx tooling/clean-source/run-gate.mts",
    "audit:dependencies:offline": "node --import tsx tooling/advisory-snapshot.mts tooling/advisories/npm-audit.snapshot.json tooling/advisories/npm-audit.snapshot.sha256 pnpm-lock.yaml",
    "audit:dependencies:live": "pnpm audit --audit-level high",
    "audit:dependencies:refresh": "node --import tsx tooling/refresh-advisory-snapshot.mts",
    "audit:licenses": "node --import tsx tooling/audit-licenses.mts",
    "audit:workflows": "node --import tsx tooling/audit-workflows.mts",
    "audit:secrets": "node --import tsx tooling/audit-secrets.mts",
    "audit:release-commands": "node --import tsx tooling/audit-release-commands.mts",
    "sbom:generate": "node --import tsx tooling/release-dry-run.mts",
    "docs:external-links:live": "node --import tsx tooling/check-external-links.mts",
    "release:platform:live": "node --import tsx tooling/check-platform-attestation.mts",
    "release:dry-run": "pnpm pack:check && node --import tsx tooling/release-dry-run.mts",
    "release:candidate:finalize": "node --import tsx tooling/finalize-release-candidate.mts .artifacts/release-dry-run",
    "verify": "pnpm verify:manifest && pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit && pnpm test:integration && pnpm test:consumer && pnpm test:executor-sh-packed && pnpm test:portability && pnpm test:examples && pnpm test:example-readmes && pnpm test:store-contracts && pnpm migration:check && pnpm test:durable-resume && pnpm test:postgres-tls && pnpm test:container-tooling && pnpm test:container && pnpm test:vercel-contract && pnpm test:ui-security && pnpm test:ui-accessibility && pnpm test:cloudflare-dry-run && pnpm test:performance && pnpm benchmark:local && pnpm api:check && pnpm registration:check && pnpm naming:check && pnpm boundaries:check && pnpm exec knip && pnpm placeholders:check && pnpm security:verify && pnpm docs:check && pnpm pack:check && pnpm release:dry-run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.58.12",
    "@pactmark/core": "workspace:*",
    "@size-limit/preset-small-lib": "13.0.3",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "@yarnpkg/cli-dist": "4.18.0",
    "bun": "1.3.14",
    "dependency-cruiser": "18.1.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.9.0",
    "knip": "6.31.0",
    "pnpm": "11.18.0",
    "prettier": "3.9.6",
    "publint": "0.3.22",
    "size-limit": "13.0.3",
    "tsdown": "0.22.14",
    "tsx": "4.23.5",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "verdaccio": "6.9.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
