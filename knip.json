{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tooling/**/*.{ts,mts,js,mjs,cjs}",
        "tests/**/*.test.ts",
        "fixtures/security/malicious-postinstall-canary/postinstall.cjs",
        "*.config.{ts,mjs,cjs}"
      ],
      "project": ["tooling/**/*.{ts,mts,js,mjs,cjs}", "tests/**/*.ts", "*.config.{ts,mjs,cjs}"]
    },
    "packages/*": {}
  },
  "ignore": ["packages/cli/tests/fixtures/*.mjs"],
  "ignoreDependencies": [
    "@eslint/js",
    "@arethetypeswrong/cli",
    "@microsoft/api-extractor",
    "@yarnpkg/cli-dist",
    "bun",
    "fast-check",
    "pnpm",
    "publint",
    "tsdown",
    "typescript-eslint",
    "zod"
  ]
}
