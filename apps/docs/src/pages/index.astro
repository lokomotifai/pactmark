---
const publicBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const englishDocumentation = `${publicBase}en/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0; url=${englishDocumentation}`} />
    <link rel="canonical" href="https://pactmark.github.io/pactmark/" />
    <title>Pactmark documentation</title>
  </head>
  <body>
    <main>
      <h1>Pactmark documentation</h1>
      <p>
        Continue to the <a href={englishDocumentation}>English documentation</a>.
      </p>
    </main>
  </body>
</html>
