# Preview is deterministic, in-memory, and loses history on process restart.
PACTMARK_PROFILE=preview

# Production-shaped auth. Never expose these values with NEXT_PUBLIC_*.
# PACTMARK_BEARER_TOKEN=
# PACTMARK_AUTH_PRINCIPAL_ID=
# PACTMARK_AUTH_TENANT_ID=

# Production persistence is intentionally not silently configured.
# PACTMARK_POSTGRES_URL=
# PACTMARK_POSTGRES_PROTECTION_KEY=
